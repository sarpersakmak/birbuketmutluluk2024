# ===============================================================
#  Bir Buket Mutluluk 2024 - Ortam Degiskenleri (ornek)
# ---------------------------------------------------------------
#  Bu dosyayi kopyalayip ".env" olarak kaydet ve gercek degerleri gir.
#  .env dosyasi Git'e KONMAZ (.gitignore ile haric tutulmustur).
#
#  Spring Boot bu degiskenleri dogrudan .env'den OKUMAZ; terminalde
#  ortam degiskeni olarak tanimlanmalidir. Ornek (Windows PowerShell):
#     $env:DB_PASSWORD = "mysql_sifren"
#     $env:JWT_SECRET  = "en-az-32-byte-uzunlugunda-gizli-anahtar"
#  Kalici tanim icin:  setx DB_PASSWORD "mysql_sifren"
# ===============================================================

# --- MySQL ---
DB_USERNAME=root
DB_PASSWORD=buraya_mysql_sifreni_yaz

# --- JWT (Asama 2'de kullanilacak) ---
JWT_SECRET=buraya-en-az-32-byte-uzunlugunda-rastgele-gizli-bir-anahtar-yaz
JWT_EXPIRATION_MS=86400000
